# SQL Server Configuration
DB_SERVER=localhost
DB_NAME=ELMDashboard
DB_USER=sa
DB_PASSWORD=YourPassword123!
DB_AUTH_TYPE=default
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Alternatively, for Azure SQL Database, use:
# DB_SERVER=your-server.database.windows.net
# DB_NAME=ELMDashboard
# DB_USER=your-username@server
# DB_PASSWORD=your-password
# DB_AUTH_TYPE=default
# DB_ENCRYPT=true
# DB_TRUST_CERT=false

# JIRA Configuration
JIRA_URL=https://jira.wolterskluwer.io/jira
JIRA_BASE_URL=https://jira.wolterskluwer.io/jira

# JIRA API Tokens (use product-specific tokens for different Jira permissions)
# Default token used as fallback
JIRA_API_TOKEN=your-default-jira-api-token

# Product-specific JIRA tokens (optional - falls back to JIRA_API_TOKEN)
JIRA_API_TOKEN_DNA=your-dna-jira-api-token
JIRA_API_TOKEN_T360=your-t360-jira-api-token
JIRA_API_TOKEN_PASSPORT=your-passport-jira-api-token

# qTest Configuration
QTEST_API_TOKEN=your-qtest-api-token
QTEST_URL=https://wk.qtestnet.com/api/v3
QTEST_PROJECT_ID=114345

# Azure DevOps Configuration
AZURE_DEVOPS_PAT=your-personal-access-token
AZURE_DEVOPS_ORG=your-org
AZURE_DEVOPS_PROJECT=your-project

# Bitbucket Configuration (for PR/dev-status integration)
# Note: Bitbucket access is typically via JIRA dev-status API, not direct
# BITBUCKET_URL=https://bitbucket.wolterskluwer.io
# BITBUCKET_API_TOKEN=your-bitbucket-api-token
